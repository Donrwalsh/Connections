# Connections — Environment Variables
# Copy this file to .env and fill in the values.

# Port for the orchestrator service
PORT=3001

# Shared secret the backend sends as the x-internal-api-key header
# on every request to the orchestrator. Keep this out of version control.
# REQUIRED — the backend and orchestrator fail fast at startup without it.
INTERNAL_API_KEY=

# OpenAI API key (used by @ai-sdk/openai in the orchestrator)
OPENAI_API_KEY=

# Google AI Studio API key (used by @ai-sdk/google in the orchestrator)
GOOGLE_API_KEY=

# Default AI model provider for requests that don't specify one — i.e. the
# in-game AI Assist endpoint. Strategy runs always select their own provider
# via the strategy name: 'llm-openai' consults OpenAI, 'llm-ollama' the
# bundled Ollama service, 'llm-google' Google AI Studio. All three providers
# are always configured and can be used simultaneously.
MODEL_PROVIDER=openai

# OpenAI model id (used when MODEL_PROVIDER=openai)
OPENAI_MODEL=gpt-4.1-nano

# Google AI Studio model id (used when MODEL_PROVIDER=google)
GOOGLE_MODEL=gemini-3.6-flash

# Hard ceiling (in tokens) on Ollama's num_ctx, never exceeded even for a
# model whose real context window is much larger — llama.cpp reserves the
# full KV-cache footprint at model-load time, not scaled to actual prompt
# length, so requesting a model's true context in full can OOM-kill Ollama
# on memory-constrained hardware. (default: 8192)
MODEL_CONTEXT_WINDOW=8192

# Ollama server base URL (used when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model id (used when MODEL_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2

# Cron pattern for daily puzzle ingestion (default: 0 6 * * * = 06:00 UTC)
PUZZLE_POPULATION_CRON=0 6 * * *

# Cron pattern for the daily OpenRouter model-metadata/pricing refresh
# (default: 0 7 * * * = 07:00 UTC, after puzzle population)
MODEL_METADATA_REFRESH_CRON=0 7 * * *

# Timezone for the puzzle population cron (default: UTC)
PUZZLE_POPULATION_TZ=UTC

# Directory the puzzle-ingestion service uses as a local cache of raw NYT
# payloads, one JSON file per date (e.g. <dir>/2024-01-01.json). Bound to the
# host's ./.puzzle-cache so it survives `docker compose down -v`. Cache is
# best-effort — failures to read/write fall back to fetching from NYT.
PUZZLE_CACHE_DIR=/app/.puzzle-cache

# Number of trials to run per puzzle for each shuffle strategy — shuffle-smart
# and shuffle-foolish share this one value (default: 3)
SHUFFLE_TRIALS=3

# Maximum number of independent trials a single LLM model may accumulate per
# puzzle (default: 3). Each trial is a separate strategy run of that model, so
# the runs can be compared against each other (like shuffle-smart/foolish).
# The limit applies per model, not per strategy run as a whole: each LLM
# dispatch queues exactly one new trial, and a different model gets its own
# independent trial budget under the same strategy/puzzle.
LLM_TRIALS_PER_MODEL=3

# Maximum repeated groups an LLM run may propose before it ends with a
# 'duplicate' status (default: 10)
LLM_MAX_DUPLICATE_GUESSES=10

# Maximum consecutive malformed LLM responses before a run ends with a
# 'malformedResponse' status (default: 3)
LLM_MAX_MALFORMED_RESPONSES=3

# Maximum consecutive transient model failures (e.g. while the Ollama model is
# still loading) before a run ends with an 'error' status. Each failure is
# retried with an exponential backoff instead of killing the run (default: 5)
LLM_MAX_MODEL_ERRORS=5

# Maximum failed guesses (wrong groups and one-aways) before a run ends with a
# 'failed' status — the NYT four-mistake rule (default: 4)
LLM_MAX_FAILED_GUESSES=4

# Maximum number of prompts a single solve step may make before the
# orchestrator gives up on a fresh candidate and reports a duplicate/invalid
# failure. Each re-prompt asks for one more distinct candidate (default: 19)
LLM_MAX_PROMPTS=19

# Number of candidate groups the LLM proposes per solve step (default: 1,
# clamped to 10). The first candidate that is not a repeat of a previous
# guess is the one submitted; if every candidate is a repeat, the first
# duplicate is recorded instead.
LLM_NUM_RESPONSES=1

# Fixed sampling temperature for LLM solve steps (default: 0.2). The
# orchestrator never changes the temperature while re-prompting — escalation
# on duplicate guesses only asks for more distinct candidates — so this single
# value applies to every model call of every step in a run.
LLM_TEMPERATURE_BASE=0.2

# How many LLM strategy runs of each provider the worker may process at once
# (default: 1). Each provider has its own queue, so llm-openai and llm-ollama
# runs never block each other; within a provider, at most this many runs are
# processed concurrently.
LLM_OPENAI_CONCURRENCY=1
LLM_OLLAMA_CONCURRENCY=1
LLM_GOOGLE_CONCURRENCY=1

# Comma-separated list of origins allowed to call the backend API.
# Defaults to http://localhost:5173 (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Credentials for Bull Board's login page at /bull/login (a real form, not a
# browser Basic Auth popup — password managers can autofill it). The backend
# fails closed: if unset, the board stays unreachable. docker-compose
# defaults these to admin/bullboard for dev convenience — override them here
# if you expose the backend beyond localhost.
BULL_BOARD_USER=
BULL_BOARD_PASS=

# Backend's base URL for the AI orchestrator service.
# Defaults to http://ai_orchestrator:3001 (compose sets it explicitly).
ORCHESTRATOR_URL=http://ai_orchestrator:3001

# Per-attempt HTTP timeout (ms) for backend→orchestrator solve calls. Some
# models legitimately take several minutes for a single call, so this is
# generous. Timeout failures are NOT retried, and now cancel the
# orchestrator's in-flight OpenAI call too (see orchestrator/app.ts) rather
# than letting it keep running — and billing — unseen.
ORCHESTRATOR_TIMEOUT_MS=600000

# Model that grades whether a correct LLM guess also named the real
# connection (POST /judge-category). Defaults shown.
JUDGE_MODEL=gpt-4.1-nano
JUDGE_PROVIDER=openai

# Postgres credentials used by the db container and backend/worker.
# Only the defaults change these — they are compose-level values.
# In production (docker-compose.prod.yml), change POSTGRES_PASSWORD from
# the default before deploying.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb

# --- Production / Coolify deployment (docker-compose.prod.yml) ---
# See README.md's "Production deployment" section for the full picture.

# Password required (as a `password` field in the request body) to call the
# dispatch endpoints that queue paid LLM provider calls: POST
# /dispatch/model/:modelName/:date, POST /dispatch/model/:modelName/runs/:n,
# and POST /dispatch/free-tier/:tier. Only enforced when NODE_ENV=production
# (docker-compose.prod.yml's backend/worker images set this automatically —
# see backend/Dockerfile) — local/dev dispatches never need it. REQUIRED in
# production: the backend fails to boot without it once NODE_ENV=production.
DISPATCH_PASSWORD=

# Which BullMQ queues a worker process consumes (default: all — unchanged
# local-dev behavior). docker-compose.prod.yml's 'worker' service hardcodes
# this to 'cloud' (every queue except llm-ollama-runs); the local machine's
# worker (docker-compose.local-ollama-worker.yml) hardcodes it to 'ollama'
# (only llm-ollama-runs). You shouldn't need to set this yourself.
WORKER_ROLE=all

# Whether this process runs pending TypeORM migrations at startup (default:
# true). docker-compose.local-ollama-worker.yml sets this to false so the
# local worker never races the deployed backend/worker's migrations against
# the same database. You shouldn't need to set this yourself either.
DB_MIGRATIONS_RUN=true

# Redis password. Optional and unset by default (matches the unauthenticated
# Redis in docker-compose.yml for local dev). REQUIRED in
# docker-compose.prod.yml, and mandatory (not just recommended) if you
# publish Redis's port so the local Ollama worker can reach it without a
# private tunnel.
REDIS_PASSWORD=

# Comma-separated list of allowed frontend origins, in production this must
# be your real frontend URL (e.g. https://connections.example.com) — the
# http://localhost:5173 default only works for local dev.
# (Already documented above as CORS_ORIGIN; repeated here as a production
# checklist item — don't forget to override it.)

# Backend origin baked into the frontend bundle at build time (Vite reads
# this as import.meta.env.VITE_API_URL). Pass it as a build arg:
#   docker compose -f docker-compose.prod.yml build --build-arg VITE_API_URL=https://api.example.com frontend
# or set VITE_API_URL in this .env before `docker compose ... build`, since
# docker-compose.prod.yml passes it through as a build arg automatically.
VITE_API_URL=
