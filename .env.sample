# Connections — Environment Variables
# Copy this file to .env and fill in the values.

# Port for the orchestrator service
PORT=3001

# Shared secret the backend sends as the x-internal-api-key header
# on every request to the orchestrator. Keep this out of version control.
INTERNAL_API_KEY=

# OpenAI API key (used by @ai-sdk/openai in the orchestrator)
OPENAI_API_KEY=

# AI model provider: "openai" (default) or "ollama" (local, via the ollama service)
MODEL_PROVIDER=openai

# OpenAI model id (used when MODEL_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-2024-08-06

# Ollama server base URL (used when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model id (used when MODEL_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2

# Cron pattern for daily puzzle ingestion (default: 0 6 * * * = 06:00 UTC)
PUZZLE_POPULATION_CRON=0 6 * * *

# Timezone for the puzzle population cron (default: UTC)
PUZZLE_POPULATION_TZ=UTC

# Number of shuffle-smart trials to run per puzzle (default: 3)
SHUFFLE_SMART_TRIALS=3

# Number of shuffle-foolish trials to run per puzzle (default: 3)
SHUFFLE_FOOLISH_TRIALS=3
