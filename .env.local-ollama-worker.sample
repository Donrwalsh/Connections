# Env file for docker-compose.local-ollama-worker.yml — runs on YOUR
# machine (the one with Ollama), not the Coolify host. Copy to
# .env.local-ollama-worker and fill in the values, then:
#   docker compose -f docker-compose.local-ollama-worker.yml --env-file .env.local-ollama-worker up -d --build
#
# This is a separate .env from the main one on purpose: it belongs to a
# different machine and points OUTWARD at your deployed stack, rather than
# describing that stack itself.

# --- Reaching your deployed Postgres from here ---
# Prefer a private tunnel hostname (Tailscale/WireGuard) over a public IP —
# see README.md for why. Must match the deployed stack's POSTGRES_* values.
REMOTE_DB_HOST=
REMOTE_DB_PORT=5432
REMOTE_DB_USER=postgres
REMOTE_DB_PASSWORD=
REMOTE_DB_NAME=mydb

# --- Reaching your deployed Redis from here ---
# Same tunnel-over-public-IP recommendation as above. Must match the
# deployed stack's REDIS_PASSWORD.
REMOTE_REDIS_HOST=
REMOTE_REDIS_PORT=6379
REMOTE_REDIS_PASSWORD=

# --- Local-only secret ---
# Shared secret between THIS machine's worker and THIS machine's
# orchestrator instance only — it never leaves this Docker network, so it
# does not need to match the deployed stack's INTERNAL_API_KEY. Any random
# string works; generate one with `openssl rand -hex 32`.
LOCAL_INTERNAL_API_KEY=

# --- Ollama ---
# Must be a model already pulled into the ollama_data volume — run
# `docker exec -it ollama ollama pull <model>` after first startup, or let
# the container pull it on first use (slower first run).
OLLAMA_MODEL=llama3.2
MODEL_CONTEXT_WINDOW=8192

# --- Optional: mirror the deployed stack's LLM tuning values ---
# Only matters if you've changed these from their defaults in the deployed
# .env — keep them in sync so llm-ollama runs behave consistently with the
# rest of the app.
LLM_OLLAMA_CONCURRENCY=1
LLM_MAX_DUPLICATE_GUESSES=10
LLM_MAX_MALFORMED_RESPONSES=3
LLM_MAX_MODEL_ERRORS=5
LLM_MAX_PROMPTS=19
LLM_NUM_RESPONSES=1
LLM_TEMPERATURE_BASE=0.2
ORCHESTRATOR_TIMEOUT_MS=120000
