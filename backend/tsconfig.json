{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "strict": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    "esModuleInterop": true,
    "ignoreDeprecations": "5.0",

    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src"]
}
